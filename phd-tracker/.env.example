# Google OAuth Client ID is NOT set here. Configure it from the app's
# Settings panel (⚙ button) — it's saved to this browser's localStorage,
# not committed to source or baked into the build.
# VITE_GOOGLE_CLIENT_ID below is only an optional fallback for local dev.
VITE_GOOGLE_CLIENT_ID=

# --- Netlify Functions (server-side only — set these in Netlify's
# Site settings > Environment variables, never in this file or in git) ---

# Telegram Bot API (@BotFather) — real secret, server-side only
TELEGRAM_BOT_TOKEN=
# Fallback destination for the scheduled cron reminder (not a secret)
TELEGRAM_CHAT_ID=

# Twilio WhatsApp — SID/Auth Token are real secrets, server-side only
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Fallback destination for the scheduled cron reminder (not a secret)
TWILIO_WHATSAPP_TO=
