# Google OAuth Client ID TIDAK ditetapkan di sini. Konfigurasikannya
# melalui panel Settings app (butang ⚙) — ia disimpan dalam localStorage
# browser, bukan dikomit ke source atau dibakar dalam build.
# VITE_GOOGLE_CLIENT_ID di bawah cuma fallback pilihan untuk dev tempatan.
VITE_GOOGLE_CLIENT_ID=

# --- Netlify Functions (server-side sahaja — tetapkan ini dalam
# Site settings > Environment variables Netlify, jangan dalam fail ni atau git) ---

# Telegram Bot API (@BotFather) — rahsia sebenar, server-side sahaja
TELEGRAM_BOT_TOKEN=
# Destinasi fallback untuk reminder cron berjadual (bukan rahsia)
TELEGRAM_CHAT_ID=

# Twilio WhatsApp — SID/Auth Token adalah rahsia sebenar, server-side sahaja
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Destinasi fallback untuk reminder cron berjadual (bukan rahsia)
TWILIO_WHATSAPP_TO=
